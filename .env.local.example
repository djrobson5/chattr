# Google Gemini API key (used by all AI routes)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres — use the POOLED connection string (host contains "-pooler").
# The pooler is PgBouncer in transaction mode, which is why src/lib/db/index.ts
# sets prepare:false.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require

# Better Auth — generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your_generated_secret_here

# Base URL for auth callbacks. http://localhost:3000 locally; the production
# origin on Vercel.
BETTER_AUTH_URL=http://localhost:3000

# --- Optional ---------------------------------------------------------------

# Extra origins allowed to call the auth endpoints, comma-separated (e.g. custom
# domains). BETTER_AUTH_URL, https://$VERCEL_URL and localhost:3000/3001 are
# always trusted.
# TRUSTED_ORIGINS=https://chat.example.com,https://www.example.com

# Open self-registration at /auth/signup. Only the exact value "true" enables it;
# unset means invite-only. Warning: anyone who finds the site can then sign up
# and run chats billed to your Gemini key.
# ALLOW_SIGNUP=true

# Model for chat, hints and translate. Default: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Model for the end-of-conversation report card. Default: gemini-2.5-flash
# GEMINI_FEEDBACK_MODEL=gemini-2.5-flash

# Report-card thinking level: minimal | low | medium | high. Unset = off.
# GEMINI_FEEDBACK_THINKING=low
